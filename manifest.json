{
    "description": "Intentional YouTube. Gain control of what you watch.",
    "manifest_version": 3,
    "name": "Focus Tube",
    "version": "0.1",
    "browser_specific_settings": {
	"gecko": {
	    "id": "focustube@example.com"
	}
    },
    "permissions": [
	"storage" // for settings
    ],
    "content_scripts": [
	{
	    "matches": ["*://*.youtube.com/*"],
	    "js": ["shorts-block.js"],
	    "css": ["focus-tube.css"]
	}
    ],
    "action": {
	"default_title": "Focus Tube",
	"default_popup": "popup/settings.html"
    }
}
